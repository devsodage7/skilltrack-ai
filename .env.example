# ==========================================================
# SkillTrack AI - environment configuration
# Copy this file to  .env  and fill in real values.
# Never commit .env to GitHub.
# ==========================================================

# Flask -----------------------------------------------------
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=skilltrack_ai
DB_POOL_SIZE=5
# Local MySQL: disabled. Cloud MySQL (TiDB/Aiven/...): required or verify_ca.
DB_SSL_MODE=disabled
# Only needed for verify_ca / verify_identity (path to the CA PEM file)
DB_SSL_CA=

# File uploads ----------------------------------------------
MAX_UPLOAD_MB=5

# Optional local LLM (Ollama) -------------------------------
# The application works completely without Ollama.
# Install from https://ollama.com then:  ollama pull llama3.2:3b
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=25

# NLP -------------------------------------------------------
# Set to false if spaCy or en_core_web_sm is not installed.
SPACY_ENABLED=true
SPACY_MODEL=en_core_web_sm
